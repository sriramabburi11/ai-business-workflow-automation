datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String        @id @default(uuid())
  name           String
  email          String        @unique
  password       String
  role           String        @default("MEMBER") // ADMIN, MANAGER, MEMBER
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  AuditLog       AuditLog[]

  @@map("users")
}

model Organization {
  id        String     @id @default(uuid())
  ownerId   String
  name      String
  createdAt DateTime   @default(now())
  users     User[]
  workflows Workflow[]

  @@map("organizations")
}

model Workflow {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  trigger        String              @default("MANUAL") // MANUAL, DOCUMENT_UPLOAD, SCHEDULE, API_WEBHOOK
  status         String              @default("ACTIVE") // ACTIVE, DRAFT, PAUSED, ARCHIVED
  createdBy      String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  steps          WorkflowStep[]
  tasks          Task[]
  documents      Document[]
  executions     WorkflowExecution[]

  @@map("workflows")
}

model WorkflowStep {
  id           String   @id @default(uuid())
  workflowId   String
  workflow     Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name         String
  type         String   // AI_EXTRACT, APPROVAL, CONDITION, NOTIFICATION, TASK_ASSIGNMENT, API_CALL
  config       String   // JSON stringified configuration
  order        Int
  assignedRole String?  @default("MANAGER")

  @@map("workflow_steps")
}

model Task {
  id          String      @id @default(uuid())
  workflowId  String
  workflow    Workflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  title       String
  description String?
  assignee    String
  status      String      @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, REJECTED
  priority    String      @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     String?
  createdAt   DateTime    @default(now())
  approvals   Approval[]

  @@map("tasks")
}

model Approval {
  id               String   @id @default(uuid())
  taskId           String
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workflowId       String
  approver         String
  decision         String   @default("PENDING") // PENDING, APPROVED, REJECTED, CHANGES_REQUESTED
  comment          String?
  aiRiskScore      Int?     @default(15) // 0 - 100 risk score generated by AI
  aiRecommendation String?  @default("APPROVE") // APPROVE, REJECT, MANUAL_REVIEW
  createdAt        DateTime @default(now())

  @@map("approvals")
}

model Document {
  id            String   @id @default(uuid())
  workflowId    String?
  workflow      Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  fileName      String
  fileUrl       String
  mimeType      String   @default("application/pdf")
  extractedData String?  // JSON string of AI extracted key-values
  createdAt     DateTime @default(now())

  @@map("documents")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  details   String   // JSON payload details
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model WorkflowExecution {
  id          String    @id @default(uuid())
  workflowId  String
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status      String    @default("RUNNING") // RUNNING, COMPLETED, FAILED
  logs        String    // JSON execution log entries
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@map("workflow_executions")
}
